{
  "version": 2,
  "builds": [
    { "src": "api/**/*.ts", "use": "@vercel/node" },
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
  ],
  "rewrites": [
    { "source": "/api/auth/signup", "destination": "/api/auth/signup.ts" },
    { "source": "/api/auth/login", "destination": "/api/auth/login.ts" },
    { "source": "/api/admin/stats", "destination": "/api/admin/stats.ts" },
    { "source": "/api/admin/users", "destination": "/api/admin/users.ts" },
    { "source": "/api/admin/users/delete", "destination": "/api/admin/users/delete.ts" },
    { "source": "/api/admin/users/update-pro", "destination": "/api/admin/users/update-pro.ts" },
    { "source": "/api/admin/users/update-admin", "destination": "/api/admin/users/update-admin.ts" },
    { "source": "/api/admin/users/update", "destination": "/api/admin/users/update.ts" },
    { "source": "/api/admin/plans/update", "destination": "/api/admin/plans/update.ts" },
    { "source": "/api/admin/plans/delete", "destination": "/api/admin/plans/delete.ts" },
    { "source": "/api/admin/plans/create", "destination": "/api/admin/plans/create.ts" },
    { "source": "/api/plans", "destination": "/api/plans.ts" },
    { "source": "/api/modules", "destination": "/api/modules.ts" },
    { "source": "/api/assessment-questions", "destination": "/api/assessment-questions.ts" },
    { "source": "/api/sync", "destination": "/api/sync.ts" },
    { "source": "/api/users", "destination": "/api/users.ts" }
  ]
}
